#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

if [[ ${EUID} -ne 0 ]]; then
  command -v sudo >/dev/null 2>&1 || fail 'sudo is required to run the installer.'
  exec sudo -- "$0" "$@"
fi

[[ -d /sys/firmware/efi ]] || fail 'Yohaku Linux currently supports UEFI installation only. Restart the Live ISO in UEFI mode.'
[[ -d /etc/yohaku/modules ]] || fail 'Yohaku configuration modules are missing from this Live ISO.'
command -v nixos-install >/dev/null 2>&1 || fail 'nixos-install is not available in this environment.'
command -v nixos-generate-config >/dev/null 2>&1 || fail 'nixos-generate-config is not available in this environment.'
command -v nixos-enter >/dev/null 2>&1 || fail 'nixos-enter is not available in this environment.'

if mountpoint -q /mnt; then
  fail '/mnt is already mounted. Unmount the previous installation target before starting again.'
fi
if find /mnt -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | grep -q .; then
  fail '/mnt is not empty. Inspect it and clear it before starting the installer.'
fi

mapfile -t candidate_disks < <(
  lsblk --json --nodeps --paths --output NAME,TYPE,RM,TRAN |
    jq -r '
      .blockdevices[]
      | select(
          .type == "disk"
          and (.rm == false or .rm == 0 or .rm == "0")
          and ((.tran // "") | ascii_downcase) != "usb"
        )
      | .name
    '
)

(( ${#candidate_disks[@]} > 0 )) || fail 'No internal non-removable disks were found. Check the device list with lsblk.'

cat <<'INTRO'

Yohaku Linux installer (experimental)

The installer uses the standard Yohaku layout:
  - UEFI boot with GPT
  - 1 GiB EFI System Partition (FAT32)
  - Remaining space as the ext4 root filesystem
  - systemd-boot
  - No swap partition

Removable disks and USB-connected disks are excluded from the target list.
The selected disk will be erased completely.

INTRO

if (( ${#candidate_disks[@]} == 1 )); then
  disk="${candidate_disks[0]}"
  printf 'One internal disk was found and selected automatically:\n'
  lsblk --nodeps --output NAME,PATH,SIZE,MODEL "$disk"
else
  printf 'Select the disk to install Yohaku Linux on:\n\n'
  for i in "${!candidate_disks[@]}"; do
    printf '  %d) ' "$((i + 1))"
    lsblk --nodeps --noheadings --output PATH,SIZE,MODEL "${candidate_disks[$i]}"
  done

  printf '\nDisk number: '
  read -r disk_selection
  [[ "$disk_selection" =~ ^[1-9][0-9]*$ ]] || fail 'Enter one of the listed disk numbers.'
  (( disk_selection <= ${#candidate_disks[@]} )) || fail 'The selected disk number is out of range.'
  disk="${candidate_disks[$((disk_selection - 1))]}"
fi

disk_type="$(lsblk --nodeps --noheadings --output TYPE "$disk" | xargs)"
[[ "$disk_type" == 'disk' ]] || fail 'The selected device is not a whole disk.'

disk_size="$(blockdev --getsize64 "$disk")"
minimum_size=$((20 * 1024 * 1024 * 1024))
(( disk_size >= minimum_size )) || fail 'The selected disk must be at least 20 GiB.'

mounted_paths="$(lsblk --noheadings --raw --output MOUNTPOINTS "$disk")"
if grep '[^[:space:]]' <<< "$mounted_paths" >/dev/null; then
  fail 'The selected disk has mounted filesystems. Unmount them before installing.'
fi

swap_devices="$(swapon --show --noheadings --raw --output NAME)"
while IFS= read -r candidate; do
  if grep -Fxq "$candidate" <<< "$swap_devices"; then
    fail "The selected disk contains active swap: $candidate"
  fi
done < <(lsblk --noheadings --raw --paths --output NAME "$disk")

printf '\nSelected disk (all partitions and data on this disk will be erased):\n'
lsblk --output NAME,PATH,SIZE,MODEL,TYPE,MOUNTPOINTS "$disk"
printf '\nTo continue, type exactly: ERASE %s\n> ' "$disk"
read -r confirmation
[[ "$confirmation" == "ERASE $disk" ]] || fail 'Confirmation did not match. Nothing was changed.'

printf '\nEnter the new account name (lowercase letters, numbers, _ and -): '
read -r username
[[ "$username" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail 'Invalid username.'

printf '\nCreating the standard Yohaku partition layout on %s.\n' "$disk"
parted --script "$disk" mklabel gpt
parted --script "$disk" mkpart primary fat32 1MiB 1025MiB
parted --script "$disk" set 1 esp on
parted --script "$disk" name 1 YOHaku-EFI
parted --script "$disk" mkpart primary ext4 1025MiB 100%
parted --script "$disk" name 2 YOHaku-root
partprobe "$disk"
udevadm settle

esp_part="$(lsblk --noheadings --raw --paths --output NAME,PARTN "$disk" | awk '$2 == 1 { print $1; exit }')"
root_part="$(lsblk --noheadings --raw --paths --output NAME,PARTN "$disk" | awk '$2 == 2 { print $1; exit }')"
[[ -b "$esp_part" ]] || fail 'Could not find the EFI partition after partitioning.'
[[ -b "$root_part" ]] || fail 'Could not find the root partition after partitioning.'

mkfs.fat -F 32 -n YOHakuEFI "$esp_part"
mkfs.ext4 -F -L yohaku "$root_part"

mkdir -p /mnt
mount "$root_part" /mnt
mkdir -p /mnt/boot
mount "$esp_part" /mnt/boot

nixos-generate-config --root /mnt
mkdir -p /mnt/etc/nixos/yohaku-modules
cp --recursive --dereference /etc/yohaku/modules/. /mnt/etc/nixos/yohaku-modules/
chmod -R u+rwX /mnt/etc/nixos/yohaku-modules

cat > /mnt/etc/nixos/configuration.nix <<NIX
{ ... }:
{
  imports = [
    ./hardware-configuration.nix
    ./yohaku-modules/base.nix
    ./yohaku-modules/japanese.nix
    ./yohaku-modules/desktop/niri.nix
    ./yohaku-modules/desktop/packages.nix
  ];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  services.displayManager.defaultSession = "niri";

  users.mutableUsers = true;
  users.users.${username} = {
    isNormalUser = true;
    extraGroups = [ "wheel" "networkmanager" ];
  };
  security.sudo.wheelNeedsPassword = true;
}
NIX

printf '\nInstalling Yohaku Linux. This requires network access and may take some time.\n'
nixos-install --root /mnt --no-root-passwd

printf '\nSet the password for %s. The password is written to the installed system, not to the Nix configuration.\n' "$username"
nixos-enter --root /mnt -c "passwd $username"

printf '\nInstallation completed.\n'
printf 'The installed system will use the account %s.\n' "$username"
printf 'Remove the installation media before rebooting.\n'
read -r -p 'Unmount the target and reboot now? [y/N] ' reboot_answer
if [[ "$reboot_answer" =~ ^[Yy]$ ]]; then
  umount -R /mnt
  reboot
else
  printf 'The target remains mounted at /mnt. Run: umount -R /mnt\n'
fi
